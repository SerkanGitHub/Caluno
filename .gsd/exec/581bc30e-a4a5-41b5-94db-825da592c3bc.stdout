ROOT FILES
- apps/mobile/build
- apps/mobile/node_modules/@playwright
- apps/mobile/playwright.config.ts
- apps/mobile/tests/mobile-predictive.unit.test.ts
- apps/mobile/tests/mobile-shift-editor-predictive.unit.test.ts
- apps/web/build
- apps/web/node_modules/@playwright
- apps/web/playwright.config.ts
- apps/web/playwright.offline.config.ts
- apps/web/test-results/e2e-offline
- packages/caluno-core/src/offline

PACKAGE SCRIPTS
[package.json]
- build: turbo run build
- dev: turbo run dev
- test: turbo run test
- lint: turbo run lint
- paraglide:compile: turbo run paraglide:compile
- format: prettier --write .
- check: turbo run check
- gsd: node --max-old-space-size=8192 $(which gsd)
- gsd:mem: node gsd-memory-logger.js

[apps/web/package.json]
- build: vite build
- check: svelte-kit sync && svelte-check --tsconfig ./tsconfig.json
- check:watch: svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch
- dev: vite dev --port 5174
- prepare: svelte-kit sync || echo ''
- preview: vite preview
- test: vitest run
- test:watch: vitest
- test:e2e: playwright test tests/e2e/auth-groups-access.spec.ts
- test:e2e:headed: playwright test tests/e2e/auth-groups-access.spec.ts --headed

[apps/mobile/package.json]
- build: vite build
- check: svelte-kit sync && svelte-check --tsconfig ./tsconfig.json
- check:watch: svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch
- dev: vite dev --port 4173
- prepare: svelte-kit sync || echo ''
- preview: vite preview
- test: vitest run
- test:watch: vitest
- test:e2e: playwright test tests/e2e/auth-scope.spec.ts tests/e2e/calendar-offline.spec.ts tests/e2e/find-time-handoff.spec.ts tests/e2e/calendar-notifications.spec.ts tests/e2e/mobile-assembly.spec.ts
- test:e2e:headed: playwright test tests/e2e/auth-scope.spec.ts tests/e2e/calendar-offline.spec.ts tests/e2e/find-time-handoff.spec.ts tests/e2e/calendar-notifications.spec.ts tests/e2e/mobile-assembly.spec.ts --headed
- cap:sync: cap sync
- cap:add:ios: cap add ios
- cap:add:android: cap add android

[packages/caluno-core/package.json]


